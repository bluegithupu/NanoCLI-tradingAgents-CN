# LLM provider: openai-compatible endpoint by default.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: use a local/OpenAI-compatible endpoint.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# Optional Tushare enhancement, not required for v1.
# TUSHARE_TOKEN=your-token
# Optional datasource strategy: tushare / akshare / auto
# NANO_DATA_SOURCE=tushare
